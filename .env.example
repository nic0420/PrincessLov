# ============================================================
# Variables de entorno - PrincessLov
# ------------------------------------------------------------
# Estas NO van en el codigo ni en data/config.js.
# Se cargan en Vercel > tu proyecto > Settings > Environment Variables
# ------------------------------------------------------------
# Este archivo es solo una plantilla de referencia: no pongas
# valores reales aca, y nunca lo subas con credenciales.
# ============================================================

# --- Mercado Pago ---
# Access Token. Empieza con TEST- en modo prueba y con APP_USR- en produccion.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Clave secreta del webhook (Tus integraciones > tu app > Webhooks > Configurar notificaciones)
MP_WEBHOOK_SECRET=

# true = usa el link sandbox de Mercado Pago. Dejalo en false salvo que lo necesites.
MP_USE_SANDBOX=false

# --- Tu tienda ---
# URL publica, sin barra al final.
FRONTEND_URL=https://princess-lov.vercel.app

# --- Google Sheets (backend de productos y pedidos) ---
# URL /exec del Web App de Apps Script.
APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# Opcional: CSV publicado, se usa solo si Apps Script no responde.
SHEETS_CSV_URL=

# --- Precios (respaldo) ---
# Se usan si no se puede leer la cotizacion de la planilla.
DOLAR_MANUAL=1200
MARGEN_GANANCIA=1.30

# --- Seguridad (auditoría 2026-09) ---
# Usuario y contraseña del panel /admin (obligatorio, si no el admin queda bloqueado)
ADMIN_USER=
ADMIN_PASSWORD=
# Mismo valor que ADMIN_TOKEN en las propiedades del Apps Script (solo si usás /api)
APPS_SCRIPT_ADMIN_TOKEN=
# true = reactiva el cobro con Mercado Pago Checkout Pro (hoy desactivado)
MP_ENABLED=false
